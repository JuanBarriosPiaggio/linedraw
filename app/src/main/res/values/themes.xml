<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LineDraw" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/void_background</item>
        <item name="android:statusBarColor">@color/void_background</item>
        <item name="android:navigationBarColor">@color/void_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Android 12+ splash screen (compat library handles pre-12 fallback). -->
    <style name="Theme.LineDraw.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/void_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">450</item>
        <item name="postSplashScreenTheme">@style/Theme.LineDraw</item>
    </style>
</resources>
